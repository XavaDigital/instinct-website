{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instinct-apparel-website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // Production hostnames. Routes run on top of the zone's existing proxied DNS
  // records (nothing in DNS is changed). The workers.dev preview URL stays on.
  "routes": [
    { "pattern": "instinct.nz/*", "zone_name": "instinct.nz" },
    { "pattern": "www.instinct.nz/*", "zone_name": "instinct.nz" }
  ],
  "workers_dev": true,
  // Submissions log (every quote request / contact message). See README → Submissions log.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "instinct-apparel-leads",
      "database_id": "42c85d40-f6f1-4deb-99a7-1a8c6744133d",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Non-secret variables. Secrets (MAILGUN_API_KEY etc.) are set with
  // `npx wrangler secret put NAME`, never committed here.
  "vars": {
    "MAILGUN_API_BASE": "https://api.mailgun.net"
  }
}
