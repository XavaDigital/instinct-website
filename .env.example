# Copy to `.env` for local development and builds. Never commit real values.
# (If a `.dev.vars` file exists it takes precedence over `.env` for the Worker
# runtime values in local dev — keep just the one file.)

# --- Mailgun: transactional email for the quote and contact forms ----------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.instinct.nz
# Use https://api.eu.mailgun.net if the Mailgun domain is in the EU region
MAILGUN_API_BASE=https://api.mailgun.net
# Where form submissions are delivered, and the sender they appear from
FORM_TO_EMAIL=hello@instinct.nz
FORM_FROM_EMAIL=website@mg.instinct.nz

# --- Cloudflare Turnstile (spam protection) -------------------------------
# Widget "Instinct forms" in the Cloudflare account (instinct.nz, the workers.dev
# preview, localhost). The site key is public and defaults in astro.config.mjs
# (a blank value here does NOT clear it — remove the default there to switch
# Turnstile off). The secret is set on the Worker with
# `npx wrangler secret put TURNSTILE_SECRET_KEY` and kept here for local runs.
# With the site key present and no secret, every submission is rejected (the
# widget shows but nothing could verify it); with neither, forms rely on the
# honeypot, timing token and in-memory rate limit only.
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEc4nmZxm1sUDh4n

# --- Site mode --------------------------------------------------------------
# Not normally needed: `npm run build:mvp` builds the ad-landing subset (no
# sport pages, no individual garment pages, no how-it-works) and `npm run build`
# builds everything. Uncomment to make a plain `npm run build` produce the MVP.
# SITE_MODE=mvp

# --- Analytics (optional; each snippet renders only when set) --------------
# Google Tag Manager container rendered on every page (defaults in astro.config.mjs;
# a blank value here does not remove it — change the default there instead)
PUBLIC_GTM_ID=GTM-MSQCHHBT
# Direct GA4 without GTM — leave empty while the GA4 tag lives in GTM
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_CF_ANALYTICS_TOKEN=
# Google Ads conversion fired on /thanks: "AW-123456789" and the label part
PUBLIC_GADS_CONVERSION_ID=
PUBLIC_GADS_CONVERSION_LABEL=
