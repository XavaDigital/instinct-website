# Copy to `.dev.vars` for local development with the Cloudflare adapter
# (or to `.env` if running with the Node adapter). Never commit real values.

# --- Mailgun: transactional email for the quote and contact forms ----------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.instinctapparel.co.nz
# Use https://api.eu.mailgun.net if the Mailgun domain is in the EU region
MAILGUN_API_BASE=https://api.mailgun.net
# Where form submissions are delivered, and the sender they appear from
FORM_TO_EMAIL=hello@instinctapparel.co.nz
FORM_FROM_EMAIL=website@mg.instinctapparel.co.nz

# --- Cloudflare Turnstile (spam protection; strongly recommended) --------
# Set BOTH keys or neither. With neither, forms rely on the honeypot, timing
# token and in-memory rate limit only. PUBLIC_TURNSTILE_SITE_KEY is baked in at
# build time, so it must be present when `npm run build` runs.
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# --- Site mode --------------------------------------------------------------
# "full" builds every page; "mvp" builds the ad-landing subset (no sport
# pages, no individual garment pages, no how-it-works). Read at build time.
SITE_MODE=full

# --- Analytics (optional; each snippet renders only when set) --------------
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_CF_ANALYTICS_TOKEN=
# Google Ads conversion fired on /thanks: "AW-123456789" and the label part
PUBLIC_GADS_CONVERSION_ID=
PUBLIC_GADS_CONVERSION_LABEL=
