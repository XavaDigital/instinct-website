---
import '@/styles/fonts.css';
import '@/styles/global.css';

import archivoItalicUrl from '@fontsource/archivo/files/archivo-latin-900-italic.woff2?url';
import barlowRegularUrl from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';

import {
  PUBLIC_GTM_ID,
  PUBLIC_GA_MEASUREMENT_ID,
  PUBLIC_CF_ANALYTICS_TOKEN,
  PUBLIC_GADS_CONVERSION_ID,
} from 'astro:env/client';

import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { site } from '@/config/site';
import { absoluteUrl, organizationJsonLd, serializeJsonLd, type Crumb } from '@/lib/seo';

interface Props {
  /** Page title. The " | Instinct Apparel" suffix is added unless `titleTemplate` is false. */
  title: string;
  titleTemplate?: boolean;
  description: string;
  /** Override the canonical URL (defaults to the current path on the production origin). */
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Extra JSON-LD objects for this page (FAQPage, Product, ...). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Breadcrumb trail rendered under the header. "Home" is prepended automatically. */
  breadcrumbs?: Crumb[];
  announcement?: boolean;
  headerCta?: 'quote' | 'phone';
  bodyClass?: string;
}

const {
  title,
  titleTemplate = true,
  description,
  canonical,
  ogImage = '/og-default.png',
  ogType = 'website',
  noindex = false,
  jsonLd,
  breadcrumbs,
  announcement = true,
  headerCta = 'quote',
  bodyClass,
} = Astro.props;

const fullTitle = titleTemplate ? `${title} | ${site.name}` : title;
// Google Tag Manager is rendered in production builds only, so `astro dev` never
// sends localhost traffic to the live container.
const gtmId = import.meta.env.PROD ? PUBLIC_GTM_ID : undefined;
// Direct gtag.js path (GA4 / Google Ads without GTM): load it once with whichever
// ID exists. Off whenever GTM is configured, so a lead is never counted twice.
const gtagLoaderId = PUBLIC_GTM_ID ? undefined : PUBLIC_GA_MEASUREMENT_ID || PUBLIC_GADS_CONVERSION_ID;
// With build.format 'file' the index route reports "/index"; normalise so the
// canonical URL is always the clean path with no extension or trailing slash.
const pathname =
  Astro.url.pathname
    .replace(/\.html$/, '')
    .replace(/\/index$/, '/')
    .replace(/(.)\/$/, '$1') || '/';
const canonicalUrl = canonical ?? absoluteUrl(pathname);
const ogImageUrl = absoluteUrl(ogImage);
const extraJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      gtmId && (
        <script is:inline define:vars={{ gtmId }}>
          /* Google Tag Manager */
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', gtmId);
        </script>
      )
    }
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonicalUrl} />}
    <meta name="theme-color" content="#1c0d3c" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" as="font" type="font/woff2" href={archivoItalicUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={barlowRegularUrl} crossorigin />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_NZ" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline type="application/ld+json" set:html={serializeJsonLd(organizationJsonLd())} />
    {extraJsonLd.map((data) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(data)} />)}

    {
      gtagLoaderId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gtagLoaderId}`} />
          <script is:inline define:vars={{ ga: PUBLIC_GA_MEASUREMENT_ID ?? '', ads: PUBLIC_GADS_CONVERSION_ID ?? '' }}>
            window.dataLayer = window.dataLayer || [];
            // Astro wraps define:vars scripts in a closure, so assign to window
            // explicitly: the thanks page calls window.gtag for conversions.
            window.gtag =
              window.gtag ||
              function () {
                dataLayer.push(arguments);
              };
            gtag('js', new Date());
            if (ga) gtag('config', ga, { anonymize_ip: true });
            if (ads) gtag('config', ads);
          </script>
        </>
      )
    }
    <!-- Remember which ad or link brought the visitor, so enquiries can be attributed. -->
    <script is:inline>
      (function () {
        try {
          var p = new URLSearchParams(location.search);
          var keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid'];
          var out = {};
          var any = false;
          for (var i = 0; i < keys.length; i++) {
            var v = p.get(keys[i]);
            if (v) {
              out[keys[i]] = v.slice(0, 200);
              any = true;
            }
          }
          var external = document.referrer && document.referrer.indexOf(location.host) === -1;
          if (any || (external && !localStorage.getItem('instinct_attribution'))) {
            if (external) out.referrer = document.referrer.slice(0, 200);
            out.landing = location.pathname;
            out.at = new Date().toISOString();
            localStorage.setItem('instinct_attribution', JSON.stringify(out));
          }
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body class:list={['flex min-h-dvh flex-col', bodyClass]}>
    {
      gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          ></iframe>
        </noscript>
      )
    }
    <a href="#main" class="skip-link">Skip to content</a>
    <Header announcement={announcement} cta={headerCta} />
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <!--
      Image slot overlay for whoever supplies photos: add ?slots to any URL to label every
      image slot with its filename and the size it is showing at right now (?slots=off to stop).
      It stays on for the browser tab, so it follows you between pages.
    -->
    <script is:inline>
      (function () {
        var q = new URLSearchParams(location.search).get('slots');
        var on = q !== null && q !== 'off';
        try {
          if (q !== null) sessionStorage.setItem('instinct_slots', on ? '1' : '0');
          else on = sessionStorage.getItem('instinct_slots') === '1';
        } catch (e) {}
        if (!on) return;

        var bar = document.createElement('div');
        bar.className = 'slot-viewport';
        document.body.appendChild(bar);
        var badges = [];
        document.querySelectorAll('[data-slot]').forEach(function (el) {
          var b = document.createElement('span');
          b.className = 'slot-badge';
          el.appendChild(b);
          badges.push([el, b]);
        });

        function update() {
          var vw = document.documentElement.clientWidth;
          var device = vw < 640 ? 'phone' : vw < 1024 ? 'tablet' : 'desktop';
          bar.textContent = 'Screen ' + vw + ' px wide (' + device + ') · ?slots=off to hide';
          badges.forEach(function (pair) {
            var r = pair[0].getBoundingClientRect();
            var w = Math.round(r.width);
            var h = Math.round(r.height);
            pair[1].textContent =
              pair[0].getAttribute('data-slot') +
              '\nShowing at ' + w + ' × ' + h + ' px' +
              '\nSharp on retina from ' + w * 2 + ' × ' + h * 2 + ' px';
          });
        }
        var frame = 0;
        addEventListener('resize', function () {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(update);
        });
        update();
      })();
    </script>
    {
      PUBLIC_CF_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${PUBLIC_CF_ANALYTICS_TOKEN}"}`}
        />
      )
    }
  </body>
</html>
