---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import { webPageJsonLd } from '@/lib/seo';

const title = 'Policies';
const description =
  'Plain-English policies from Instinct Apparel covering shipping and delivery, returns and faults, artwork and IP, payment and deposits, privacy, and sizing.';

const policies = (await getCollection('policies')).sort((a, b) => a.data.order - b.data.order);
const monthYear = (d: Date) => d.toLocaleDateString('en-NZ', { month: 'short', year: 'numeric' });
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[{ label: 'Policies' }]}
  jsonLd={webPageJsonLd({ name: title, description, url: '/policies', type: 'CollectionPage' })}
>
  <section class="hero-glow-right">
    <div class="container-x pb-10 pt-12 lg:pt-[52px]">
      <span class="eyebrow">Policies</span>
      <h1 class="display mt-3 text-[40px] leading-[0.96] tracking-[-0.035em] sm:text-[56px]">How we do things</h1>
      <p class="mt-3 max-w-[640px] text-[17.5px] leading-[1.6] text-white/[0.72]">
        Plain-English policies covering shipping, returns, artwork, privacy and payment. Each one opens in full — the
        summary is what most people need.
      </p>
    </div>
  </section>

  <section class="bg-plum-900">
    <div class="container-x pb-14">
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          policies.map((p, i) => (
            <li>
              <a
                href={`/policies/${p.id}`}
                class:list={[
                  'group block h-full border border-white/10 border-t-[3px] bg-plum-850 px-6 py-[26px] transition-colors hover:bg-plum-800',
                  i % 3 === 0 || i % 3 === 2 ? 'border-t-lime' : 'border-t-lilac',
                ]}
              >
                <div class="font-mono text-[11px] font-semibold uppercase leading-none tracking-[0.16em] text-white/60">
                  Updated {monthYear(p.data.updated)}
                </div>
                <h2 class="card-title mb-2 mt-3 text-[22px] leading-[1.15] group-hover:text-lime-soft">{p.data.title}</h2>
                <p class="mb-[14px] text-[14.5px] leading-[1.6] text-white/[0.68]">{p.data.summary}</p>
                <span class="link-lime text-[12.5px]">Read policy <span aria-hidden="true">→</span></span>
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/terms"
            class="group block h-full border border-white/10 border-t-[3px] border-t-white/30 bg-plum-850 px-6 py-[26px] transition-colors hover:bg-plum-800"
          >
            <div class="font-mono text-[11px] font-semibold uppercase leading-none tracking-[0.16em] text-white/60">Legal</div>
            <h2 class="card-title mb-2 mt-3 text-[22px] leading-[1.15] group-hover:text-lime-soft">Terms &amp; conditions</h2>
            <p class="mb-[14px] text-[14.5px] leading-[1.6] text-white/[0.68]">
              The terms that apply to every quote, order and delivery. The policies above form part of them.
            </p>
            <span class="link-lime text-[12.5px]">Read the terms <span aria-hidden="true">→</span></span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <CtaBand
    title="Something not covered?"
    body="Ask us before you order — we'd rather answer a question now than surprise you later."
    secondary={{ label: 'Contact us', href: '/contact' }}
    watermark="POLICY"
  />
</BaseLayout>
