---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import { nav } from '@/config/site';
import { routeEnabled } from '@/config/mode';
import { webPageJsonLd } from '@/lib/seo';

const title = 'Size charts';
const description =
  'Indicative size charts for Instinct Apparel hoodies, jerseys, shorts and socks — junior 4Y to adult 5XL. Ask for a sizing kit to confirm before you order.';

const charts = (await getCollection('sizeCharts')).sort((a, b) => a.data.order - b.data.order);
const chartsWithGarments = await Promise.all(
  charts.map(async (c) => ({ chart: c, garment: c.data.garment ? await getEntry('garments', c.data.garment) : undefined })),
);

const howTo = [
  { title: 'Half chest', body: 'Lay the garment flat and measure straight across, 2cm below the armhole. Double it for the full chest.' },
  { title: 'Body length', body: 'From the highest point of the shoulder, next to the collar, straight down to the hem.' },
  { title: 'Waist', body: 'Lay shorts flat and measure straight across the top of the waistband, relaxed (not stretched).' },
  { title: 'Compare, don\'t guess', body: 'Measure a garment that already fits well and match it to the closest size in the chart.' },
];
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[{ label: 'FAQ', href: '/faq' }, { label: 'Size charts' }]}
  jsonLd={webPageJsonLd({ name: title, description, url: '/size-charts' })}
>
  <section class="hero-glow">
    <div class="container-x pb-10 pt-12 lg:pt-[52px]">
      <span class="eyebrow">Sizing &amp; fit</span>
      <h1 class="display mt-3 text-[40px] leading-[0.96] tracking-[-0.035em] sm:text-[56px]">Size charts</h1>
      <p class="mt-3 max-w-[640px] text-[17.5px] leading-[1.6] text-white/[0.72]">
        Garment measurements in centimetres, laid flat. Every size is graded from the same design, so a club can
        order 4Y through to 5XL in one look. For anything bigger than a social team, ask for a
        <a href="/faq#sizing-fit" class="link-inline">sizing kit</a> and let players try before you confirm.
      </p>
    </div>
  </section>

  <section class="bg-plum-850">
    <div class="container-x py-10">
      <h2 class="display mb-6 text-[26px] sm:text-[30px]">How to measure</h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          howTo.map((h) => (
            <li class="panel-deep px-5 py-5">
              <h3 class="text-[15.5px] font-bold text-white">{h.title}</h3>
              <p class="mt-2 text-[14.5px] leading-[1.6] text-white/65">{h.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-plum-900">
    <div class="container-x grid gap-12 py-14">
      {
        chartsWithGarments.map(({ chart, garment }) => (
          <div id={chart.id} class="scroll-mt-24">
            <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
              <h2 class="display text-[28px] sm:text-[34px]">{chart.data.title}</h2>
              {garment && routeEnabled(`/teamwear/${garment.id}`) && (
                <a href={`/teamwear/${garment.id}`} class="link-lime">
                  {garment.data.cardTitle} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
            {chart.data.note && <p class="mb-4 text-[14.5px] text-white/60">{chart.data.note}</p>}
            <div class="overflow-x-auto border border-white/[0.12]">
              <table class="w-full min-w-[480px] text-[14.5px] leading-[1.4]">
                <thead>
                  <tr class="bg-plum-800 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-white/60">
                    {chart.data.columns.map((c) => (
                      <th scope="col" class="px-4 py-[13px] text-left">
                        {c}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {chart.data.rows.map((row) => (
                    <tr class="border-t border-white/10">
                      {row.map((cell, i) =>
                        i === 0 ? (
                          <th scope="row" class="px-4 py-3 text-left font-mono text-[13px] font-semibold text-white">
                            {cell}
                          </th>
                        ) : (
                          <td class="px-4 py-3 text-white/85">{cell}</td>
                        ),
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }
      <p class="text-[14px] leading-[1.6] text-white/50">
        Measurements are indicative and may vary by ±1.5cm, which is normal for sublimated garments. See our
        <a href="/policies/sizing-fit" class="link-inline">sizing and fit assurance policy</a> for how we handle a genuine
        sizing miss.
      </p>
    </div>
  </section>

  <CtaBand
    title="Not sure which size run to order?"
    body="Ask for a sizing kit with your quote and we'll help you plan the spread so nobody is left out."
    ctaHref={nav.cta.href}
    watermark="SIZES"
  />
</BaseLayout>
