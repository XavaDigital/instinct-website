---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { nav, site } from '@/config/site';
import { enabledLinks } from '@/config/mode';

const links = enabledLinks([
  { label: 'Club teamwear', href: '/teamwear' },
  { label: 'Sports', href: '/sports' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Contact', href: '/contact' },
]);
---

<BaseLayout title="Page not found" description="That page doesn't exist. Head back to the Instinct Apparel homepage or request a quote." noindex>
  <section class="hero-glow relative overflow-hidden">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -bottom-[60px] -right-[30px] select-none font-display text-[140px] font-black italic leading-none tracking-[-0.05em] text-white/[0.035] sm:text-[220px]"
    >
      404
    </div>
    <div class="container-x relative py-20 lg:py-28">
      <span class="eyebrow">Error 404</span>
      <h1 class="display mt-3 max-w-[720px] text-[40px] leading-[0.96] tracking-[-0.035em] sm:text-[58px]">
        That page went missing in the gear bag
      </h1>
      <p class="mt-4 max-w-[560px] text-[17.5px] leading-[1.6] text-white/[0.72]">
        The link may be old or mistyped. Try one of these, or call us on
        <a href={site.phone.href} class="link-inline">{site.phone.display}</a>.
      </p>
      <div class="mt-8 flex flex-wrap gap-[14px]">
        <a href="/" class="btn btn-primary">Back to the homepage</a>
        <a href={nav.cta.href} class="btn btn-outline">Request a quote</a>
      </div>
      <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-3">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="link-lime">
                {l.label} →
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
