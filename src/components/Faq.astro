---
/**
 * Accordion built on <details>/<summary>: no JavaScript, fully indexable,
 * keyboard accessible. Answers may contain simple inline markdown links.
 */
interface Props {
  items: { q: string; a: string }[];
  /** Open the first item by default */
  openFirst?: boolean;
  /** Prefix for ids so several accordions can share a page */
  idPrefix?: string;
}
const { items, openFirst = false, idPrefix = 'faq' } = Astro.props;

/** Convert [text](href) and paragraph breaks to HTML; escape everything else. */
function renderAnswer(text: string): string {
  const escape = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  return text
    .split(/\n\s*\n/)
    .map((para) => {
      const withLinks = escape(para).replace(
        /\[([^\]]+)\]\(([^)]+)\)/g,
        (_m, label: string, href: string) => `<a href="${href}">${label}</a>`,
      );
      return `<p>${withLinks}</p>`;
    })
    .join('');
}
---

<div class="grid">
  {
    items.map((item, i) => (
      <details class="faq" open={openFirst && i === 0} id={`${idPrefix}-${i + 1}`}>
        <summary>
          <h3 class="text-[16.5px] font-bold leading-[1.3]">{item.q}</h3>
        </summary>
        <div class="faq-body" set:html={renderAnswer(item.a)} />
      </details>
    ))
  }
</div>
