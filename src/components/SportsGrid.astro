---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { routeEnabled } from '@/config/mode';
import { sportHero } from '@/lib/images';

interface Props {
  sports: CollectionEntry<'sports'>[];
  current?: string;
  /** "tile": large 3-column tiles. "mini": compact 6-column strip. */
  variant?: 'tile' | 'mini';
  class?: string;
}
const { sports, current, variant = 'tile', class: className } = Astro.props;
// In MVP mode the sport pages are not built, so tiles render as plain text.
const linked = routeEnabled('/sports');
---

<ul
  class:list={[
    'grid',
    variant === 'tile' ? 'gap-[14px] sm:grid-cols-2 md:grid-cols-3' : 'grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6',
    className,
  ]}
>
  {
    sports.map((s) => {
      const Tag = linked ? 'a' : 'div';
      const hero = s.data.heroImage ?? sportHero(s.id);
      return (
        <li>
          <Tag
            href={linked ? `/sports/${s.id}` : undefined}
            aria-current={linked && s.id === current ? 'page' : undefined}
            class:list={[
              'hatch group relative flex items-center justify-center overflow-hidden border text-center',
              linked && 'transition-colors hover:border-lime/60 hover:bg-plum-600',
              variant === 'tile' ? 'min-h-[150px] bg-plum-650 px-4' : 'min-h-[110px] bg-plum-700 px-3',
              s.id === current ? 'border-lime bg-plum-650' : 'border-white/[0.09]',
            ]}
          >
            {hero && (
              <Image
                src={hero}
                alt=""
                widths={[400, 800]}
                sizes="(min-width: 768px) 33vw, 100vw"
                class="absolute inset-0 h-full w-full object-cover opacity-60 transition-opacity group-hover:opacity-80"
              />
            )}
            <span
              class:list={[
                'relative text-white',
                variant === 'tile'
                  ? 'font-display text-[20px] font-bold uppercase tracking-[0.04em]'
                  : 'text-[14px] font-bold leading-tight',
                s.id === current && 'text-lime-soft',
              ]}
            >
              {s.data.navLabel ?? s.data.title}
            </span>
          </Tag>
        </li>
      );
    })
  }
</ul>
