---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { routeEnabled } from '@/config/mode';
import { slotFile, sportHero } from '@/lib/images';

interface Props {
  sports: CollectionEntry<'sports'>[];
  current?: string;
  /** "tile": large 3-column outlined tiles with lime text, no photo. "mini": compact 6-column strip with the sport photo. */
  variant?: 'tile' | 'mini';
  class?: string;
}
const { sports, current, variant = 'tile', class: className } = Astro.props;
// In MVP mode the sport pages are not built, so tiles render as plain text.
const linked = routeEnabled('/sports');
---

<ul
  class:list={[
    'grid',
    variant === 'tile' ? 'gap-[14px] sm:grid-cols-2 md:grid-cols-3' : 'grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6',
    className,
  ]}
>
  {
    sports.map((s) => {
      const Tag = linked ? 'a' : 'div';
      const label = s.data.navLabel ?? s.data.title;
      if (variant === 'tile') {
        return (
          <li>
            <Tag
              href={linked ? `/sports/${s.id}` : undefined}
              aria-current={linked && s.id === current ? 'page' : undefined}
              class:list={[
                'flex min-h-[150px] items-center justify-center border border-white/[0.11] bg-gradient-to-b from-lime/[0.07] to-transparent px-4 text-center',
                linked && 'transition-colors hover:border-lime/60',
              ]}
            >
              <span class="font-display text-[24px] font-bold uppercase leading-[1.1] tracking-[0.04em] text-lime sm:text-[26px]">
                {label}
              </span>
            </Tag>
          </li>
        );
      }
      const hero = s.data.heroImage ?? sportHero(s.id);
      return (
        <li>
          <Tag
            href={linked ? `/sports/${s.id}` : undefined}
            aria-current={linked && s.id === current ? 'page' : undefined}
            data-slot={`${slotFile.sport(s.id)} · 2400 × 1500`}
            class:list={[
              'hatch group relative flex min-h-[110px] flex-col items-center justify-center gap-2 overflow-hidden border bg-plum-700 px-3 text-center',
              linked && 'transition-colors hover:border-lime/60 hover:bg-plum-600',
              s.id === current ? 'border-lime bg-plum-650' : 'border-white/[0.09]',
            ]}
          >
            {hero && (
              <Image
                src={hero}
                alt=""
                widths={[400, 800]}
                sizes="(min-width: 768px) 33vw, (min-width: 640px) 50vw, 100vw"
                class="absolute inset-0 h-full w-full object-cover opacity-60 transition-opacity group-hover:opacity-80"
              />
            )}
            <span class:list={['relative text-[14px] font-bold leading-tight text-white', s.id === current && 'text-lime-soft']}>
              {label}
            </span>
          </Tag>
        </li>
      );
    })
  }
</ul>
